{
	"extends": "@trenaryja/config/tsconfig/vite",
	"compilerOptions": {
		"jsx": "react", // pens import React from esm.sh; the automatic runtime's bare `react/jsx-runtime` import has no resolver on CodePen
		"types": ["vite/client", "bun"] // penx.ts is a Bun CLI living next to the browser code
	},
	"include": ["src", "penx.ts", "vite.config.ts", "esm-sh.d.ts"]
}
